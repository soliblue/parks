#!/usr/bin/env bash
set -euo pipefail

PARKS_ROOT="${PARKS_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
PARKS_ENV_FILE="${PARKS_ENV_FILE:-/home/soli/projects/soli.blue/.env}"

cd "$PARKS_ROOT"

if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  printf 'Refusing to deploy a tracked dirty worktree.\n' >&2
  exit 1
fi

if [[ ! -r "$PARKS_ENV_FILE" ]]; then
  printf 'Cloudflare environment file is not readable: %s\n' "$PARKS_ENV_FILE" >&2
  exit 1
fi

set -a
source "$PARKS_ENV_FILE"
set +a

: "${CLOUDFLARE_ACCOUNT_ID:?CLOUDFLARE_ACCOUNT_ID is required}"
: "${CLOUDFLARE_API_TOKEN:?CLOUDFLARE_API_TOKEN is required}"

npm run data:check

if [[ "${PARKS_SKIP_BUILD:-0}" != "1" ]]; then
  npm run build
fi

PARKS_COMMIT_SHA="$(git rev-parse HEAD)"
if ! DEPLOY_OUTPUT="$(npx wrangler pages deploy dist \
  --project-name=parks \
  --branch=main \
  --commit-hash="$PARKS_COMMIT_SHA" \
  --commit-dirty=false 2>&1)"; then
  printf '%s\n' "$DEPLOY_OUTPUT" >&2
  exit 1
fi
printf '%s\n' "$DEPLOY_OUTPUT"

DEPLOYMENT_URL="$(printf '%s\n' "$DEPLOY_OUTPUT" |
  grep -Eo 'https://[[:alnum:].-]+\.pages\.dev' |
  tail -n 1)"
if [[ -z "$DEPLOYMENT_URL" ]]; then
  printf 'Wrangler did not report an immutable deployment URL.\n' >&2
  exit 1
fi

ASSET_PATHS=()
for ASSET_FILE in "$PARKS_ROOT"/dist/assets/*.js "$PARKS_ROOT"/dist/assets/*.css; do
  [[ -f "$ASSET_FILE" ]] || continue
  ASSET_PATHS+=("/assets/${ASSET_FILE##*/}")
done
if [[ "${#ASSET_PATHS[@]}" -eq 0 ]]; then
  printf 'No built JavaScript or CSS assets found in dist/assets.\n' >&2
  exit 1
fi

verify_json() {
  local url="$1"
  local kind="$2"
  local expected="${3:-}"
  local body

  for _ in {1..20}; do
    if body="$(curl --fail --silent --show-error --location \
      --retry 3 --retry-delay 2 --retry-all-errors "$url")" &&
      printf '%s' "$body" |
        JSON_KIND="$kind" JSON_EXPECTED="$expected" node -e '
          let body = "";
          process.stdin.on("data", chunk => body += chunk).on("end", () => {
            let value;
            try {
              value = JSON.parse(body);
            } catch {
              process.exit(1);
            }
            const kind = process.env.JSON_KIND;
            if (value.schemaVersion !== 1) process.exit(1);
            if (kind === "cities") {
              const ids = new Set(value.cities?.map(city => city.id));
              for (const id of [
                "berlin", "vienna", "munich", "stuttgart", "madrid",
                "barcelona", "cairo", "paris", "copenhagen",
              ]) {
                if (!ids.has(id)) process.exit(1);
              }
            } else if (kind === "access") {
              for (const id of [
                "berlin", "vienna", "munich", "stuttgart", "madrid",
                "barcelona", "cairo", "paris", "copenhagen",
              ]) {
                const city = value.cities?.[id];
                if (
                  city?.method !== "walking-network" ||
                  city?.populationYear !== 2020 ||
                  city?.thresholdMinutes !== 10 ||
                  !(city?.sharePercent >= 0 && city.sharePercent <= 100)
                ) process.exit(1);
              }
            } else if (
              kind === "summary" &&
              value.city !== process.env.JSON_EXPECTED
            ) {
              process.exit(1);
            }
          });
        '; then
      return 0
    fi
    sleep 3
  done

  printf 'JSON verification failed after propagation retries: %s\n' "$url" >&2
  return 1
}

verify_asset() {
  local base_url="$1"
  local asset_path="$2"
  local expected_type
  local content_type
  local probe_url

  case "$asset_path" in
    *.js) expected_type="application/javascript" ;;
    *.css) expected_type="text/css" ;;
    *)
      printf 'Unsupported asset verification type: %s\n' "$asset_path" >&2
      return 1
      ;;
  esac

  for ATTEMPT in {1..20}; do
    probe_url="${base_url}${asset_path}?deployment=${PARKS_COMMIT_SHA}-${ATTEMPT}"
    if content_type="$(curl --fail --silent --show-error --location \
      --header "Origin: $base_url" \
      --output /dev/null \
      --write-out '%{content_type}' \
      "$probe_url")" &&
      [[ "$content_type" == "$expected_type"* ]]; then
      if content_type="$(curl --fail --silent --show-error --location \
        --header "Origin: $base_url" \
        --output /dev/null \
        --write-out '%{content_type}' \
        "${base_url}${asset_path}")" &&
        [[ "$content_type" == "$expected_type"* ]]; then
        return 0
      fi
    fi
    sleep 3
  done

  printf 'Asset verification failed after propagation retries: %s%s\n' \
    "$base_url" "$asset_path" >&2
  return 1
}

verify_missing_asset() {
  local base_url="$1"
  local headers
  local status
  local cache_control

  for ATTEMPT in {1..20}; do
    headers="$(curl --silent --show-error --location \
      --dump-header - \
      --output /dev/null \
      "${base_url}/assets/missing-${PARKS_COMMIT_SHA}-${ATTEMPT}.js" |
      tr -d '\r')"
    status="$(printf '%s\n' "$headers" |
      awk '/^HTTP\// { value = $2 } END { print value }')"
    cache_control="$(printf '%s\n' "$headers" |
      awk -F ': *' 'tolower($1) == "cache-control" { value = tolower($2) } END { print value }')"
    if [[ "$status" == "404" && "$cache_control" != *immutable* ]]; then
      return 0
    fi
    sleep 3
  done

  printf 'Missing-asset verification failed after propagation retries: %s\n' \
    "$base_url" >&2
  return 1
}

declare -A CITY_NAMES=(
  [berlin]="Berlin"
  [vienna]="Wien"
  [munich]="München"
  [stuttgart]="Stuttgart"
  [madrid]="Madrid"
  [barcelona]="Barcelona"
  [cairo]="Kairo"
  [paris]="Paris"
  [copenhagen]="Kopenhagen"
)

for URL in "$DEPLOYMENT_URL" "https://parks.soli.blue"; do
  curl --fail --silent --show-error --location \
    --retry 20 --retry-delay 5 --retry-all-errors "$URL/" > /dev/null
  verify_json "$URL/data/cities.json" cities
  verify_json "$URL/data/access.json" access
  for CITY in \
    berlin vienna munich stuttgart madrid barcelona cairo paris copenhagen; do
    verify_json \
      "$URL/data/$CITY/summary.json" \
      summary \
      "${CITY_NAMES[$CITY]}"
  done
  verify_missing_asset "$URL"
  for ASSET_PATH in "${ASSET_PATHS[@]}"; do
    verify_asset "$URL" "$ASSET_PATH"
  done
done

printf 'Verified %s and https://parks.soli.blue\n' "$DEPLOYMENT_URL"
